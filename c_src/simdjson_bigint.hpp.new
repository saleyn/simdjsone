#pragma once

#include <vector>
#include <cmath>
#include <cstdint>
#include <string>
#include <string_view>
#include <erl_nif.h>
#include "simdjson.h"

namespace simdjsone {

using namespace simdjson;

// Unfortunately there's no NIF support for big integers.  We use the following
// workaround - encode the integer from a string into the binary term format.
// Then use the 'enif_binary_to_term' to convert that into an Erlang term, which
// represents a big number.  This approach works for arbitrarily large integers.

struct BigInt {
  // Creates a BigInteger Erlang term that corresponds to a number stored as a string.
  // E.g. "12345678901234567890123" will be returned as a BigInt 12345678901234567890123.
  // The function returns 0 if the decoding fails.
  // This version supports arbitrarily large integers by automatically choosing
  // between small and large big integer formats.
  static ERL_NIF_TERM
  decode(ErlNifEnv* env, const char* begin, const char* end)
  {
    if (begin >= end) [[unlikely]]
      return 0;

    auto neg = false;
    if (*begin == '-') {
      ++begin;
      neg = true;
    }

    if (begin >= end) [[unlikely]]  // Just a minus sign
      return 0;

    // Skip leading zeros but keep at least one digit
    while (begin < end - 1 && *begin == '0') {
      ++begin;
    }

    std::vector<unsigned char> result;
    auto len = approx_digits(end - begin);
    constexpr const size_t small_header_size = 4; // version + tag + length + sign
    constexpr const size_t large_header_size = 7; // version + tag + 4-byte-length + sign

    result.reserve(len + large_header_size);

    // Start with large big integer format (we'll adjust if needed)
    result.push_back(131);                // Version byte
    result.push_back(int('o'));           // Large BIG integer ERL_LARGE_BIG_EXT (111)
    result.push_back(0); result.push_back(0); result.push_back(0); result.push_back(0); // 4-byte length placeholder
    result.push_back(neg ? 1 : 0);        // Sign byte

    convert_to_base256(result, result.begin() + large_header_size, begin, end);
    auto byte_size = result.size() - large_header_size;

    // Check if conversion failed (result was cleared due to invalid input)
    if (byte_size == 0 || result.size() < large_header_size) [[unlikely]]
      return 0;

    ERL_NIF_TERM out;

    if (byte_size <= 255) [[likely]] {
      // Use small big integer format for better efficiency
      std::vector<unsigned char> small_result;
      small_result.reserve(byte_size + small_header_size);
      small_result.push_back(131);         // Version byte
      small_result.push_back(int('n'));    // Small BIG integer ERL_SMALL_BIG_EXT (110)
      small_result.push_back(static_cast<unsigned char>(byte_size)); // 1-byte length
      small_result.push_back(neg ? 1 : 0); // Sign byte

      // Copy the base256 digits
      small_result.insert(small_result.end(),
                         result.begin() + large_header_size,
                         result.end());

      if (!enif_binary_to_term(env, small_result.data(), small_result.size(), &out, 0)) [[unlikely]]
        return 0;
    } else {
      // Use large big integer format
      put32be(result.data() + 2, static_cast<uint32_t>(byte_size));

      if (!enif_binary_to_term(env, result.data(), result.size(), &out, 0)) [[unlikely]]
        return 0;
    }

    return out;
  }

  // Encodes an Erlang big integer term to a JSON string representation.
  // Returns an empty string if encoding fails.
  static std::string
  encode(ErlNifEnv* env, ERL_NIF_TERM term)
  {
    ErlNifBinary bin;

    // Convert the Erlang term to binary format
    if (!enif_term_to_binary(env, term, &bin)) [[unlikely]]
      return {};

    // Parse the binary format to extract the big integer
    if (bin.size < 2) [[unlikely]] {
      enif_release_binary(&bin);
      return {};
    }

    const unsigned char* data = bin.data;
    size_t pos = 0;

    // Skip version byte
    if (data[pos++] != 131) [[unlikely]] {
      enif_release_binary(&bin);
      return {};
    }

    if (pos >= bin.size) [[unlikely]] {
      enif_release_binary(&bin);
      return {};
    }

    bool is_negative = false;
    std::vector<unsigned char> digits;

    unsigned char tag = data[pos++];
    if (tag == int('n')) { // Small BIG integer
      if (pos + 2 > bin.size) [[unlikely]] {
        enif_release_binary(&bin);
        return {};
      }

      size_t byte_len = data[pos++];
      is_negative = data[pos++] != 0;

      if (pos + byte_len > bin.size) [[unlikely]] {
        enif_release_binary(&bin);
        return {};
      }

      digits.assign(data + pos, data + pos + byte_len);
    } else if (tag == int('o')) { // Large BIG integer
      if (pos + 5 > bin.size) [[unlikely]] {
        enif_release_binary(&bin);
        return {};
      }

      uint32_t byte_len = get32be(data + pos);
      pos += 4;
      is_negative = data[pos++] != 0;

      if (pos + byte_len > bin.size) [[unlikely]] {
        enif_release_binary(&bin);
        return {};
      }

      digits.assign(data + pos, data + pos + byte_len);
    } else {
      // Not a big integer
      enif_release_binary(&bin);
      return {};
    }

    enif_release_binary(&bin);

    // Convert base-256 digits to decimal string
    std::string result = convert_from_base256(digits);

    if (is_negative && result != "0") {
      result = "-" + result;
    }

    return result;
  }

private:
  static inline void convert_to_base256(
    std::vector<unsigned char>& result,
    std::vector<unsigned char>::iterator it,
    const char* begin, const char* end)
  {
    if (begin >= end) return;

    result.push_back(*begin++ - '0');

    for(; begin != end; ++begin) {
      if (*begin < '0' || *begin > '9') [[unlikely]] {
        // Invalid digit - clear result to indicate failure
        result.clear();
        return;
      }
      mul10(result, it);           // multiply result by 10
      add(result, it, *begin-'0'); // add current digit
    }
  }

  static inline size_t approx_digits(size_t decimal_dig_count) {
    const auto factor = std::log(10) / std::log(256);
    return std::ceil(factor * decimal_dig_count) + 1; // +1 for safety
  }

  static inline void put32be(uint8_t* s, uint32_t n) {
    *s++ = (n >> 24) & 0xff;
    *s++ = (n >> 16) & 0xff;
    *s++ = (n >>  8) & 0xff;
    *s   = n         & 0xff;
  }

  static inline uint32_t get32be(const uint8_t* s) {
    return (static_cast<uint32_t>(s[0]) << 24) |
           (static_cast<uint32_t>(s[1]) << 16) |
           (static_cast<uint32_t>(s[2]) << 8) |
           static_cast<uint32_t>(s[3]);
  }

  // Convert base-256 digits back to decimal string
  static std::string convert_from_base256(const std::vector<unsigned char>& digits)
  {
    if (digits.empty()) return "0";

    // Use vector to store decimal digits
    std::vector<unsigned char> decimal_digits;
    decimal_digits.reserve(digits.size() * 3); // Rough estimate

    // Copy base-256 digits (reversed order for processing)
    std::vector<unsigned char> temp_digits(digits.rbegin(), digits.rend());

    // Convert to decimal by repeatedly dividing by 10
    while (!temp_digits.empty() && !is_zero(temp_digits)) {
      unsigned char remainder = div10(temp_digits);
      decimal_digits.push_back(remainder + '0');
    }

    if (decimal_digits.empty()) {
      return "0";
    }

    // Reverse to get most significant digit first
    std::string result(decimal_digits.rbegin(), decimal_digits.rend());
    return result;
  }

  static bool is_zero(const std::vector<unsigned char>& digits) {
    for (auto d : digits) {
      if (d != 0) return false;
    }
    return true;
  }

  // Divide the base-256 number by 10, return remainder
  static unsigned char div10(std::vector<unsigned char>& digits) {
    unsigned int carry = 0;
    for (auto it = digits.begin(); it != digits.end(); ++it) {
      unsigned int temp = carry * 256 + *it;
      *it = temp / 10;
      carry = temp % 10;
    }

    // Remove leading zeros
    while (!digits.empty() && digits.front() == 0) {
      digits.erase(digits.begin());
    }

    return static_cast<unsigned char>(carry);
  }

  static inline void add
  (
    std::vector<unsigned char>&          num,
    std::vector<unsigned char>::iterator start,
    int                                  digit
  ) {
    for (auto end=num.end(); digit && start != end; ++start) {
      int x  = *start + digit;
      *start = x & 255;
      digit  = x >> 8;
    }
    if (digit)
      num.push_back(digit);
  }

  static inline void mul10(
    std::vector<unsigned char>& num,
    std::vector<unsigned char>::iterator start
  ) {
    auto carry = 0;
    for (auto end=num.end(); start != end; ++start) {
      carry   = 10 * *start + carry;
      *start  = static_cast<uint8_t>(carry);
      carry >>= 8;
    }
    if (carry)
      num.push_back(carry);
  }
};

} // namespace simdjsone
